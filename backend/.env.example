# Copy this file to backend/.env and fill in the values. Never commit .env.

# Server
PORT=5000
# Frontend URL(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/doctor_booking_db

# Auth - use a long random string (min 32 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seed script (npm run seed) - creates the admin and demo doctor logins
ADMIN_EMAIL=admin@prescripto.test
ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=

# AI Doctor Finder (Google Gemini) - get a key at https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Optional: AI request timeout (ms) and per-IP limit for AI endpoints
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=10
